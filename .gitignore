# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Text files
*.txt
*.md
!README.md
!rig_tail_documentation.md

# Worktree shelf launchers. Local development tooling: they run the tool
# from whichever checkout they sit in, so a tracked copy would ship a
# branch-testing installer to every user of the module.
install_worktree.py
uninstall_worktree.py
